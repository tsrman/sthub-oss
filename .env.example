# WARNING: every credential in this file is for local development only. Do not
# use these values in a shared environment; provide unique secrets instead.

# Database — the streamlit password in this local URL is development-only.
DATABASE_URL=postgresql+asyncpg://streamlit:streamlit@db:5432/streamlit_registry

# Keycloak (OIDC)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=streamlit-platform
KEYCLOAK_CLIENT=streamlit-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ALLOWED_GROUPS=streamlit-users
KEYCLOAK_ADMIN_GROUP=streamlit-admins
KEYCLOAK_VERIFY_SSL=false
# WARNING: admin/admin is local-only bootstrap access; replace both values for shared use.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Redis / worker queue
REDIS_URL=redis://redis:6379
ARQ_QUEUE_NAME=arq:streamlit
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT=3600

# Public URLs and Docker worker configuration
PUBLIC_HOST=
DOCKER_HOST=unix:///var/run/docker.sock
CONTROL_NETWORK=sthub-control
DOCKER_NETWORK=streamlit-limited
STREAMLIT_BASE_IMAGE=streamlit-base:latest
# Traefik entrypoint for deployed app containers: "web" for the plain-HTTP
# stack (compose.yaml), "websecure" for the TLS stack (compose.tls.yaml).
TRAEFIK_ENTRYPOINT=web

# Default per-app resource limits
CONTAINER_MEMORY=512m
CONTAINER_MEMORY_RESERVATION=128m
CONTAINER_CPU_QUOTA=50000
CONTAINER_CPU_PERIOD=100000
CONTAINER_PIDS_LIMIT=100
CONTAINER_TMPFS_SIZE=64m
CONTAINER_TMPFS_RUNTIME_SIZE=32m

# Quotas and file-size limits
MAX_RUNNING_APPS_PER_USER=5
MAX_FILES_PER_STREAMLIT=100
MAX_FILE_SIZE_BYTES=5242880
MAX_CODE_SIZE=5242880
MAX_REQUIREMENTS_SIZE=1048576

# Allowed pip packages (comma-separated whitelist)
ALLOWED_PACKAGES=streamlit,pandas,numpy,scipy,plotly,altair,pydeck,pillow,sqlalchemy,pymysql,psycopg2-binary,openpyxl,xlrd,pyarrow,fastparquet,scikit-learn,matplotlib,requests,httpx,pyyaml,python-dotenv,tabulate,rich,jsonschema

# CORS origins (comma-separated; "*" permits any origin in this local sample)
CORS_ALLOW_ORIGINS=*

# AI code assistant — backend-only and disabled by default. The browser calls
# the Control API and never receives the gateway URL or API key.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TIMEOUT=120
# This sample intentionally has no host CA bind mount. If a self-hosted OpenAI-compatible gateway
# needs one, use a documented Compose override with real host/container paths.
AI_CA_CERT=
AI_VERIFY_SSL=true
AI_MAX_CONTEXT_CHARS=20000
# System prompt for the assistant. The built-in default is English; override it
# to change the assistant's persona, house style, or response language.
# AI_SYSTEM_PROMPT=
