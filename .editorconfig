root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# Upstream texts are preserved byte-for-byte; see .gitattributes.
[third_party/licenses/**]
trim_trailing_whitespace = false
insert_final_newline = false

[frontend/public/monaco-editor/**]
trim_trailing_whitespace = false
insert_final_newline = false
